{
  "name": "lazyorch",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "LazyOrch — AI agent orchestration daemon with multi-backend adapters",
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@11.18.0",
  "scripts": {
    "build": "tsc -b && pnpm --filter @lazyorch/gui build",
    "clean": "tsc -b --clean",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -b --pretty false && tsc -p tests --pretty false && pnpm --filter @lazyorch/gui typecheck",
    "test": "vitest run && pnpm --filter @lazyorch/gui test",
    "test:watch": "vitest",
    "gui:dev": "pnpm --filter @lazyorch/gui dev",
    "gui:build": "pnpm --filter @lazyorch/gui build"
  },
  "devDependencies": {
    "@eslint/js": "^9.18.0",
    "@lazyorch/adapters": "workspace:*",
    "@lazyorch/core": "workspace:*",
    "@lazyorch/shared": "workspace:*",
    "@types/node": "^22.10.5",
    "eslint": "^9.18.0",
    "eslint-config-prettier": "^10.0.1",
    "globals": "^15.14.0",
    "prettier": "^3.4.2",
    "typescript": "^5.7.3",
    "typescript-eslint": "^8.20.0",
    "vitest": "^3.0.2"
  }
}
